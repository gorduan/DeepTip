{
  "name": "deeptip",
  "version": "1.0.0",
  "private": true,
  "description": "Explanation windows with depth (Paradox-style tooltips in tooltips) — spec, web runtime, glossary tools",
  "license": "MIT",
  "author": "Gorduan",
  "homepage": "https://github.com/gorduan/DeepTip",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorduan/DeepTip.git"
  },
  "type": "module",
  "exports": {
    ".": "./frameworks/web/deeptip.js",
    "./css": "./frameworks/web/deeptip.css",
    "./core/*": "./glossary/core/*"
  },
  "bin": {
    "deeptip-check": "tools/deeptip-check.mjs",
    "deeptip-sync": "tools/deeptip-sync.mjs"
  },
  "scripts": {
    "test": "node --test test/deeptip.test.mjs test/cases.test.mjs && node tools/skill.mjs --check",
    "check": "node tools/deeptip-check.mjs glossary/core && node tools/deeptip-check.mjs --base de glossary/core/de.json glossary/example/de.json glossary/core/en.json glossary/example/en.json",
    "demo": "python -m http.server 5560",
    "cases": "node test/make-cases.mjs",
    "package": "node tools/package.mjs",
    "skill": "node tools/skill.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
